{
  "name": "backend",
  "version": "1.0.0",
  "description": "MongoDB Express Node TypeScript REST API",
  "homepage": "https://github.com/Sinyedu/AroundYou#readme",
  "bugs": {
    "url": "https://github.com/Sinyedu/AroundYou/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sinyedu/AroundYou.git"
  },
  "license": "ISC",
  "author": "Helena",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "build": "rm -rf ./dist && tsc",
    "start": "node dist/index.js",
    "start-dev": "cross-env NODE_ENV=development npx nodemon",
    "test": "playwright test",
    "test:e2e": "playwright test"
  },
  "nodemonConfig": {
    "verbose": false,
    "watch": [
      "src"
    ],
    "ext": "js,ts",
    "exec": "npx ts-node ./src/index.ts",
    "ignore": [
      "node_modules"
    ]
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.6",
    "crawlee": "^3.18.1",
    "cross-env": "^10.1.0",
    "dotenv-flow": "^4.1.0",
    "express": "^5.2.1",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.0",
    "mongoose": "^9.6.2",
    "multer": "^2.1.1",
    "nodemon": "^3.1.14",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/joi": "^17.2.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.3.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
